<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0"
    name="os_quick_start"
    uuid="DCB01DEB-D018-4257-8D17-F41E3B49865D">
    <target name="quick_start">
        <root class="APPLICATION" feature="make"/>
        <setting name="console_application" value="true"/>
        <setting name="executable_name" value="os_quick_start"/>
        <capability>
            <concurrency support="thread" use="thread"/>
            <void_safety support="all" use="all"/>
        </capability>
        <library name="gobo_free_elks" location="${GOBO}/library/free_elks/library_${GOBO_EIFFEL}.ecf">
            <condition><custom name="GOBO_EIFFEL" value="ge"/></condition>
        </library>
        <library name="ise_base" location="$ISE_LIBRARY/library/base/base.ecf">
            <condition><custom name="GOBO_EIFFEL" excluded_value="ge"/></condition>
        </library>
        <library name="ise_thread" location="$ISE_LIBRARY/library/thread/thread.ecf">
            <condition><custom name="GOBO_EIFFEL" excluded_value="ge"/></condition>
        </library>
        <library name="gobo_thread" location="${GOBO}/library/thread/library_${GOBO_EIFFEL}.ecf">
            <condition><custom name="GOBO_EIFFEL" value="ge"/></condition>
        </library>
        <library name="os" location="../../os.ecf" readonly="true"/>
        <cluster name="quick_start" location="." recursive="false"/>
    </target>
</system>
