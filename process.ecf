<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0"
    name="os_process"
    uuid="35B8909C-8467-4AA9-BD7F-EA5AA6A350A6"
    library_target="os_process">
    <target name="os_process">
        <root all_classes="true"/>
        <capability>
            <concurrency support="thread"/>
            <void_safety support="all" use="all"/>
        </capability>
        <library name="gobo_free_elks" location="${GOBO}/library/free_elks/library_${GOBO_EIFFEL}.ecf">
            <condition><custom name="GOBO_EIFFEL" value="ge"/></condition>
        </library>
        <library name="ise_base" location="$ISE_LIBRARY/library/base/base.ecf">
            <condition><custom name="GOBO_EIFFEL" excluded_value="ge"/></condition>
        </library>
        <library name="ise_thread" location="$ISE_LIBRARY/library/thread/thread.ecf">
            <condition><custom name="GOBO_EIFFEL" excluded_value="ge"/></condition>
        </library>
        <library name="gobo_thread" location="${GOBO}/library/thread/library_${GOBO_EIFFEL}.ecf">
            <condition><custom name="GOBO_EIFFEL" value="ge"/></condition>
        </library>
        <external_include location="$ECF_CONFIG_PATH/c"/>
        <external_library location="$ECF_CONFIG_PATH/build/native/libos_process.a">
            <condition>
                <platform excluded_value="windows"/>
            </condition>
        </external_library>
        <external_library location="$ECF_CONFIG_PATH/build/native/os_process.lib">
            <condition>
                <platform value="windows"/>
            </condition>
        </external_library>
        <cluster name="process" location="src/process" recursive="false"/>
        <cluster name="process_native" location="src/process/backend/native" recursive="true"/>
    </target>
    <target name="os_process_test_child" extends="os_process">
        <root class="OS_PROCESS_TEST_CHILD" feature="make"/>
        <setting name="console_application" value="true"/>
        <setting name="executable_name" value="os_process_test_child"/>
        <capability>
            <concurrency support="thread" use="thread"/>
        </capability>
        <cluster name="process_test_support" location="tests/process/support" recursive="false"/>
    </target>
    <target name="os_process_tests" extends="os_process">
        <root class="OS_PROCESS_TEST_SUITE" feature="make"/>
        <setting name="console_application" value="true"/>
        <setting name="executable_name" value="os_process_tests"/>
        <capability>
            <concurrency support="thread" use="thread"/>
        </capability>
        <library name="gobo_test" location="${GOBO}/library/test/library_skl.ecf" readonly="true"/>
        <library name="gobo_regexp" location="${GOBO}/library/regexp/library.ecf" readonly="true"/>
        <cluster name="process_tests" location="tests/process" recursive="false"/>
        <cluster name="process_testgen" location="build/testgen/process" recursive="false"/>
    </target>
</system>
